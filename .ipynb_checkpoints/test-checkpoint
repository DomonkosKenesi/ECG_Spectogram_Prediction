   "source": [
    "# new: per-class test recall for each seed. Shows which diagnoses are stable across seeds\n",
    "# and which ones flip between learned and collapsed (recall 0).\n",
    "recall_table = pd.concat(seed_recalls, axis=1)\n",
    "recall_table[\"mean\"] = recall_table.mean(axis=1)\n",
    "recall_table[\"std\"] = recall_table[[f\"seed {s}\" for s in SEEDS]].std(axis=1)\n",
    "display(recall_table.round(3))\n",
    "\n",
    "px.imshow(\n",
    "    recall_table[[f\"seed {s}\" for s in SEEDS]].values,\n",
    "    x=[f\"seed {s}\" for s in SEEDS], y=kept_labels,\n",
    "    text_auto=\".2f\", zmin=0, zmax=1, color_continuous_scale=\"Blues\",\n",
