   "source": [
    "frequency = 10 ** 3\n",
    "window_length = 2 ** 13\n",
    "a_record = records_df.iloc[42]\n",
    "ecg_signals = a_record[\"signals\"]"
   ]
  },
  {
   "cell_type": "code",
