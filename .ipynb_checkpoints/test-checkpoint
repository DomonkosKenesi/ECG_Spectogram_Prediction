    "# new: run the 3 seeds (3 x N_EPOCHS of training) and collect test metrics per seed.\n",
    "seed_rows, seed_recalls, seed_histories = [], [], []\n",
    "for seed in SEEDS:\n",
    "    y_true_s, y_pred_s, best_valid_bacc, hist = train_one_seed(seed)\n",
    "    seed_rows.append({\n",
