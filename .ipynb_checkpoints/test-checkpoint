   "id": "baeba984-053d-4be5-8684-d2e253be96d8",
   "metadata": {},
   "outputs": [],
   "source": [
    "from scipy.signal import resample_poly\n",
    "from functools import partial\n",
    "downsample_factor = 2 ** 3\n",
    "downsample = partial(resample_poly, up=1, down=downsample_factor)\n",
    "ecg_downsampled_signals = downsample(ecg_signals)\n",
    "downsampled_frequency = frequency / downsample_factor\n",
    "downsampled_signal_i = ecg_downsampled_signals[: (window_length // downsample_factor), 0]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 41,
   "id": "75928d7b-2b67-443a-8631-4b2063248b8c",
   "metadata": {},
   "outputs": [],
   "source": [
    "def augment(x: np.ndarray, start: float, window_length: int) -> np.ndarray:\n",
    "    start_el = int(start * (len(x) - window_length))\n",
    "    stop_el = start_el + window_length\n",
    "    return x[start_el:stop_el, :]\n"
   ]
  },
