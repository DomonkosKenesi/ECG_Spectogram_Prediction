    "        fold_indices = shuffled_df[\"patient\"][j::N_FOLDS].index\n",
    "        fold = (j + total) % N_FOLDS  # Rotate the number of the fold which gets residual elements\n",
    "        patients_trainvalid.loc[fold_indices, \"fold\"] = fold\n",
    "    total += len(shuffled_df)\n",
    "patients_trainvalid"
   ]
